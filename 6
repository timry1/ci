# A16 BFS на взвешенном графе: а почему не работает?


from collections import deque

# Дан взвешенный граф
graph = {
    0: [(1, 10), (2, 1)],
    1: [(3, 1)],
    2: [(1, 1), (3, 10)],
    3: []
}

# BFS - ищет путь с минимальным количеством ребер,слоями (веса игнорирует)
def bfs(start, end):
    q = deque([(start, [start])])      # очередь: (вершина, путь)
    visited = set()                     # посещенные вершины
    
    while q:
        v, path = q.popleft()
        
        if v == end:
            return path
        
        if v not in visited:
            visited.add(v)
            for u, _ in graph[v]:      #вес игнорируем
                if u not in visited:
                    q.append((u, path + [u]))
    
    return None

# Находим все пути от start до end
def all_paths(start, end, path=None):
    if path is None:
        path = [start]
    
    if start == end:
        return [path]
    
    res = []
    for v, _ in graph[start]:
        if v not in path:               # чтобы не было циклов(бесконеч)
            new = all_paths(v, end, path + [v])
            res.extend(new)
    
    return res

# Считаем вес пути
def get_weight(path):
    w = 0
    for i in range(len(path) - 1):
        for v, weight in graph[path[i]]:
            if v == path[i + 1]:
                w += weight
                break
    return w


#ВЫПОЛНЕНИЕ()()

# 1. BFS
bfs_path = bfs(0, 3)
print("BFS нашел путь:", " -> ".join(map(str, bfs_path)))
print("Вес пути:", get_weight(bfs_path))
print()

# 2. Все пути
paths = all_paths(0, 3)
print("Все возможные пути:")
for p in paths:
    print("  ", " -> ".join(map(str, p)), "вес =", get_weight(p))

# 3. Кратчайший по весу
best = min(paths, key=get_weight)
print("\nКратчайший по весу:", " -> ".join(map(str, best)))
print("Вес:", get_weight(best))
print()

