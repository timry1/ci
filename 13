# B9:Задача: Реализация принципов Interface Segregation (ISP) и Dependency Inversion (DIP)
from abc import ABC, abstractmethod
from typing import List, Dict, Any


# часть 1: isp (interface segregation principle)

class WorkerInterface(ABC):
    """толстый интерфейс — антипример"""
    
    @abstractmethod
    def work(self) -> str:
        pass
    
    @abstractmethod
    def eat(self) -> str:
        pass
    
    @abstractmethod
    def sleep(self) -> str:
        pass


class BadRobot(WorkerInterface):
    """робот вынужден реализовывать ненужные методы — нарушение isp"""
    
    def work(self) -> str:
        return "робот работает..."
    
    def eat(self) -> str:
        raise NotImplementedError("роботы не едят")
    
    def sleep(self) -> str:
        raise NotImplementedError("роботы не спят")


# правильное решение: разделяем интерфейсы
class Workable(ABC):
    """только работа"""
    
    @abstractmethod
    def work(self) -> str:
        pass


class Eatable(ABC):
    """только еда"""
    
    @abstractmethod
    def eat(self) -> str:
        pass


class Sleepable(ABC):
    """только сон"""
    
    @abstractmethod
    def sleep(self) -> str:
        pass


class Robot(Workable):
    """робот реализует только workable — нет лишних методов"""
    
    def work(self) -> str:
        return "робот: работаю без перерыва"


class Human(Workable, Eatable, Sleepable):
    """человек реализует все интерфейсы"""
    
    def work(self) -> str:
        return "человек: работаю над задачей"
    
    def eat(self) -> str:
        return "человек: обедаю"
    
    def sleep(self) -> str:
        return "человек: сплю 8 часов"


# часть 2: dip (dependency inversion principle)

class Database(ABC):
    """абстракция базы данных"""
    
    @abstractmethod
    def fetch_data(self) -> List[Dict[str, Any]]:
        pass
    
    @abstractmethod
    def get_name(self) -> str:
        pass


class PostgreSQLDatabase(Database):
    """реализация postgresql"""
    
    def fetch_data(self) -> List[Dict[str, Any]]:
        return [
            {"id": 1, "amount": 100, "product": "ноутбук"},
            {"id": 2, "amount": 50, "product": "мышь"},
        ]
    
    def get_name(self) -> str:
        return "postgresql"


class InMemoryDatabase(Database):
    """реализация inmemory"""
    
    def fetch_data(self) -> List[Dict[str, Any]]:
        return [
            {"id": 1, "amount": 200, "product": "телефон"},
            {"id": 2, "amount": 75, "product": "наушники"},
            {"id": 3, "amount": 30, "product": "чехол"},
        ]
    
    def get_name(self) -> str:
        return "inmemory"


class ReportService:
    """сервис зависит от абстракции database, а не от конкретной реализации"""
    
    def __init__(self, database: Database):
        self._database = database
    
    def generate(self, period: str = "q1") -> str:
        data = self._database.fetch_data()
        db_name = self._database.get_name()
        records_count = len(data)
        total_amount = sum(item.get("amount", 0) for item in data)
        return f"{db_name}: отчёт за {period} ({records_count} записей, сумма: {total_amount})"


