from typing import Callable, Dict, Any, List, Optional
from dataclasses import dataclass, field
from time import time
from copy import deepcopy


class Context:
    """
    Контекст выполнения правил.
    Хранит данные в виде словаря и ведёт историю изменений.
    """
    
    def __init__(self, initial_data: Optional[Dict[str, Any]] = None):
        # внутреннее хранилище данных
        self._data = initial_data.copy() if initial_data else {}
        # история изменений (для отчёта)
        self._history: List[Dict[str, Any]] = []
    
    def get(self, key: str, default: Any = None) -> Any:
        """получить значение по ключу"""
        return self._data.get(key, default)
    
    def set(self, key: str, value: Any) -> None:
        """установить значение и записать в историю"""
        old_value = self._data.get(key)
        self._data[key] = value
        self._history.append({
            'key': key,
            'old_value': old_value,
            'new_value': value
        })
    
    def get_history(self) -> List[Dict[str, Any]]:
        """вернуть историю изменений"""
        return self._history.copy()
    
    def copy(self) -> 'Context':
        """создать копию контекста (для dry_run)"""
        new_context = Context()
        new_context._data = self._data.copy()
        return new_context
    
    def __repr__(self) -> str:
        return f"Context({self._data})"


@dataclass
class Rule:
    """
    Правило бизнес-процесса.
    
    Поля:
    - name: уникальное имя правила
    - priority: приоритет (меньше число = выше приоритет)
    - condition: функция, возвращающая True/False
    - action: функция, изменяющая контекст
    - tags: метки для группового выполнения
    - enabled: активно ли правило
    """
    name: str
    priority: int
    condition: Callable[['Context'], bool]
    action: Callable[['Context'], None]
    tags: List[str] = field(default_factory=list)
    enabled: bool = True


@dataclass
class ExecutionReport:
    """
    Отчёт о выполнении правил.
    """
    fired_rules: List[str]          # названия сработавших правил
    skipped_rules: List[str]        # названия пропущенных правил
    total_time_ms: float            # общее время выполнения в миллисекундах
    context_changes: List[Dict[str, Any]]  # история изменений контекста


class RuleEngine:
    """
    Движок правил (Business Rules Engine).
    Выполняет правила по приоритету (forward chaining).
    """
    
    def __init__(self):
        self._rules: List[Rule] = []  # список всех правил
    
    def add_rule(self, rule: Rule) -> None:
        """добавить правило в движок"""
        self._rules.append(rule)
    
    def _get_sorted_rules(self) -> List[Rule]:
        """
        вернуть правила, отсортированные по приоритету.
        при одинаковом приоритете сохраняется порядок добавления.
        """
        return sorted(self._rules, key=lambda r: r.priority)
    
    def execute(self, context: Context) -> ExecutionReport:
        """
        выполнить все правила по порядку.
        правила могут изменять контекст, влияя на последующие правила.
        """
        start_time = time()
        fired = []
        skipped = []
        
        for rule in self._get_sorted_rules():
            # проверяем, активно ли правило
            if not rule.enabled:
                skipped.append(rule.name)
                continue
            
            # проверяем условие
            if rule.condition(context):
                # если условие истинно, выполняем действие
                rule.action(context)
                fired.append(rule.name)
            else:
                skipped.append(rule.name)
        
        end_time = time()
        total_time_ms = (end_time - start_time) * 1000
        
        return ExecutionReport(
            fired_rules=fired,
            skipped_rules=skipped,
            total_time_ms=total_time_ms,
            context_changes=context.get_history()
        )
    
    def execute_tagged(self, context: Context, tags: List[str]) -> ExecutionReport:
        """
        выполнить только правила, содержащие хотя бы один из указанных тегов.
        """
        start_time = time()
        fired = []
        skipped = []
        
        for rule in self._get_sorted_rules():
            if not rule.enabled:
                skipped.append(rule.name)
                continue
            
            # проверяем пересечение тегов
            if not any(tag in rule.tags for tag in tags):
                skipped.append(rule.name)
                continue
            
            if rule.condition(context):
                rule.action(context)
                fired.append(rule.name)
            else:
                skipped.append(rule.name)
        
        end_time = time()
        total_time_ms = (end_time - start_time) * 1000
        
        return ExecutionReport(
            fired_rules=fired,
            skipped_rules=skipped,
            total_time_ms=total_time_ms,
            context_changes=context.get_history()
        )
    
    def dry_run(self, context: Context) -> List[str]:
        """
        определить, какие правила сработали бы, не изменяя контекст.
        использует копию контекста, чтобы не влиять на оригинал.
        """
        dry_context = context.copy()  # работаем с копией
        fired = []
        
        for rule in self._get_sorted_rules():
            if not rule.enabled:
                continue
            
            if rule.condition(dry_context):
                rule.action(dry_context)  # изменяем только копию
                fired.append(rule.name)
        
        return fired  # возвращаем только названия, без изменений оригинала


# ==================== вспомогательные функции для создания правил ====================

def always_true(ctx: Context) -> bool:
    """условие, которое всегда истинно"""
    return True

def set_score(value: int) -> Callable[[Context], None]:
    """действие: установить score в указанное значение"""
    def action(ctx: Context) -> None:
        ctx.set('score', value)
    return action

def add_score(value: int) -> Callable[[Context], None]:
    """действие: добавить value к текущему score"""
    def action(ctx: Context) -> None:
        current = ctx.get('score', 0)
        ctx.set('score', current + value)
    return action

def sub_score(value: int) -> Callable[[Context], None]:
    """действие: вычесть value из текущего score"""
    def action(ctx: Context) -> None:
        current = ctx.get('score', 0)
        ctx.set('score', current - value)
    return action

def set_risk(level: str) -> Callable[[Context], None]:
    """действие: установить уровень риска"""
    def action(ctx: Context) -> None:
        ctx.set('risk', level)
    return action

def approve() -> Callable[[Context], None]:
    """действие: одобрить заявку"""
    def action(ctx: Context) -> None:
        ctx.set('approved', True)
    return action


# ==================== правила для кредитного скоринга ====================

def create_scoring_rules() -> List[Rule]:
    """
    создаёт правила для кредитного скоринга.
    порядок priority определяет последовательность выполнения.
    """
    return [
        Rule(
            name='base_score',
            priority=1,
            condition=always_true,
            action=set_score(500),
            tags=['scoring', 'always'],
            enabled=True
        ),
        Rule(
            name='income_bonus',
            priority=2,
            condition=lambda ctx: ctx.get('income', 0) > 50000,
            action=add_score(100),
            tags=['scoring', 'income'],
            enabled=True
        ),
        Rule(
            name='age_penalty',
            priority=3,
            condition=lambda ctx: ctx.get('age', 0) < 25,
            action=sub_score(50),
            tags=['scoring', 'age'],
            enabled=True
        ),
        Rule(
            name='debt_risk',
            priority=4,
            condition=lambda ctx: ctx.get('debt', 0) > ctx.get('income', 0) * 0.5,
            action=set_risk('high'),
            tags=['risk', 'debt'],
            enabled=True
        ),
        Rule(
            name='final_decision',
            priority=5,
            condition=lambda ctx: ctx.get('score', 0) > 550,
            action=approve(),
            tags=['decision'],
            enabled=True
        ),
    ]


