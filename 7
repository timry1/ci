# Задача B14, d-арная куча DaryHeap.Реализовать класс DaryHeap(d) — d-арную Min-Heap

import random

class DaryHeap:
    """d-арная Min-Heap (минимальный элемент в корне)"""
    
    def __init__(self, d):
        self.d = d                    # количество детей у узла
        self.heap = []                # массив для хранения элементов
        self.comparisons = 0          # счётчик сравнений
    
    # ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ ДЛЯ РАБОТЫ С ИНДЕКСАМИ
    
    def _parent(self, i):
        """родитель узла i: (i-1)//d"""
        return (i - 1) // self.d
    
    def _child(self, i, k):
        """k-й ребёнок узла i (k от 1 до d): d*i + k"""
        return self.d * i + k
    
    # ОСНОВНЫЕ ОПЕРАЦИИ (push, peek, pop)
    
    def push(self, val):
        """добавить элемент в кучу"""
        self.heap.append(val)                     # добавляем в конец
        self._heapify_up(len(self.heap) - 1)      # поднимаем вверх
    
    def peek(self):
        """посмотреть минимальный элемент (не удаляя)"""
        return self.heap[0]
    
    def pop(self):
        """удалить и вернуть минимальный элемент"""
        min_val = self.heap[0]                    # запоминаем минимум
        last = self.heap.pop()                    # удаляем последний
        
        if self.heap:                             # если куча не пустая
            self.heap[0] = last                   # ставим последний наверх
            self._heapify_down(0)                 # опускаем вниз
        
        return min_val
    
    # ВНУТРЕННИЕ МЕТОДЫ ДЛЯ ПОДДЕРЖАНИЯ СВОЙСТВ КУЧИ
    
    def _heapify_up(self, i):
        """подъём элемента вверх (используется в push)"""
        while i > 0:
            p = self._parent(i)
            self.comparisons += 1                 # считаем сравнение
            
            if self.heap[i] < self.heap[p]:       # если меньше родителя
                self.heap[i], self.heap[p] = self.heap[p], self.heap[i]  # меняем
                i = p                             # поднимаемся выше
            else:
                break                             # на своём месте
    
    def _heapify_down(self, i):
        """опускание элемента вниз (используется в pop)"""
        n = len(self.heap)
        
        while True:
            min_child = i
            first = self._child(i, 1)                     # первый ребёнок
            last = min(self._child(i, self.d), n - 1)     # последний ребёнок
            
            # ищем минимального среди всех детей
            for child in range(first, last + 1):
                if child >= n:
                    break
                self.comparisons += 1                     # считаем сравнение
                if self.heap[child] < self.heap[min_child]:
                    min_child = child
            
            # если текущий элемент меньше всех детей — останов
            if min_child == i:
                break
            
            # меняем с минимальным ребёнком
            self.heap[i], self.heap[min_child] = self.heap[min_child], self.heap[i]
            i = min_child                                 # опускаемся ниже
    
    # СЛУЖЕБНЫЙ МЕТОД ДЛЯ СБРОСА СЧЁТЧИКА
    
    def reset_comparisons(self):
        """сброс счётчика сравнений"""
        self.comparisons = 0


# ТЕСТИРОВАНИЕ

small_data = [16, 14, 10, 8, 7, 9, 3, 2, 4, 1]
large_data = [random.randint(1, 10000) for _ in range(1000)]

print("=" * 70)
