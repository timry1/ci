# ТЕСТ ДЛЯ РАЗНЫХ ЗНАЧЕНИЙ d

for d in [2, 4, 8]:
    print(f"\n{'─' * 70}")
    print(f"DaryHeap(d = {d})")
    print(f"{'─' * 70}")
    
    #тест на маленьком наборе (10 чисел)
    heap = DaryHeap(d)
    push_total = 0
    pop_total = 0
    
    for x in small_data:
        heap.push(x)
        push_total += heap.comparisons
        heap.reset_comparisons()
    
    while heap.heap:
        heap.pop()
        pop_total += heap.comparisons
        heap.reset_comparisons()
    
    print(f"Маленький набор (10 чисел):")
    print(f"  push: {push_total} сравнений")
    print(f"  pop:  {pop_total} сравнений")
    print(f"  всего: {push_total + pop_total}")
    
    #тест на большом наборе (1000 случайных чисел)
    heap = DaryHeap(d)
    push_total = 0
    pop_total = 0
    
    for x in large_data:
        heap.push(x)
        push_total += heap.comparisons
        heap.reset_comparisons()
    
    while heap.heap:
        heap.pop()
        pop_total += heap.comparisons
        heap.reset_comparisons()
    
    print(f"\nБольшой набор (1000 случайных чисел):")
    print(f"  push: {push_total} сравнений")
    print(f"  pop:  {pop_total} сравнений")
    print(f"  всего: {push_total + pop_total}")

