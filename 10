from collections import deque

#bst из b14: двоичное дерево поиска 

def bst_insert(root, val):
    """вставка значения в bst"""
    if root is None:
        return {'val': val, 'left': None, 'right': None}
    
    if val < root['val']:
        root['left'] = bst_insert(root['left'], val)
    elif val > root['val']:
        root['right'] = bst_insert(root['right'], val)
    
    return root

def bst_search(root, val):
    """поиск значения в bst"""
    if root is None:
        return False
    if val == root['val']:
        return True
    elif val < root['val']:
        return bst_search(root['left'], val)
    else:
        return bst_search(root['right'], val)

def bst_inorder(root):
    """симметричный обход (l-node-r)"""
    if root is None:
        return []
    return bst_inorder(root['left']) + [root['val']] + bst_inorder(root['right'])

def bst_height(root):
    """высота дерева"""
    if root is None:
        return 0
    return 1 + max(bst_height(root['left']), bst_height(root['right']))

def bst_count(root):
    """количество узлов"""
    if root is None:
        return 0
    return 1 + bst_count(root['left']) + bst_count(root['right'])


#b16: обходы дерева

def bst_preorder(root):
    """
    прямой обход (node-l-r)
    доказательство корректности:
    - базовый случай: пустое дерево → [] ✓
    - шаг: рекурсивно обходим левое и правое поддеревья
    - инвариант: сначала корень, потом всё левое, потом всё правое
    """
    if root is None:
        return []
    return [root['val']] + bst_preorder(root['left']) + bst_preorder(root['right'])

def bst_inorder_traversal(root):
    """
    симметричный обход (l-node-r)
    доказательство корректности:
    - для bst возвращает отсортированный список
    - по свойству bst: левое < корень < правое
    - по индукции: левое отсортировано, правое отсортировано
    - конкатенация сохраняет порядок сортировки
    """
    if root is None:
        return []
    return bst_inorder_traversal(root['left']) + [root['val']] + bst_inorder_traversal(root['right'])

def bst_postorder(root):
    """
    обратный обход (l-r-node)
    доказательство корректности:
    - базовый случай: пустое дерево → [] ✓
    - шаг: сначала левое, потом правое, потом корень
    - инвариант: все потомки обрабатываются раньше родителя
    """
    if root is None:
        return []
    return bst_postorder(root['left']) + bst_postorder(root['right']) + [root['val']]

def bst_levelorder(root):
    """
    обход по уровням (bfs через deque)
    доказательство корректности:
    - используем fifo-очередь: сначала обрабатываем корень
    - при обработке узла добавляем его детей в конец очереди
    - инвариант: все узлы уровня d обрабатываются раньше уровня d+1
    - deque даёт o(1) на popleft(), list.pop(0) был бы o(n)
    """
    if root is None:
        return []
    
    result = []
    queue = deque([root])
    
    while queue:
        node = queue.popleft()
        result.append(node['val'])
        
        if node['left']:
            queue.append(node['left'])
        if node['right']:
            queue.append(node['right'])
    
    return result

#сериализация

def serialize(root):
    """
    сериализация дерева через pre-order обход
    pre-order выбран потому что:
    - восстановить дерево можно за один проход
    - структура сохраняется (корень, потом левое, потом правое)
    """
    if root is None:
        return ['#']
    
    return [str(root['val'])] + serialize(root['left']) + serialize(root['right'])

def deserialize(data):
    """десериализация дерева из pre-order списка"""
    def helper():
        val = next(values_iter)
        if val == '#':
            return None
        
        node = {'val': int(val), 'left': None, 'right': None}
        node['left'] = helper()
        node['right'] = helper()
        return node
    
    values_iter = iter(data)
    return helper()

